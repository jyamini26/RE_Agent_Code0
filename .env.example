# ---------------------------------------------------------------------------
# REAP configuration
#
# Every value below has a working default. The app runs with no .env at all;
# copy this file to .env only when you want to override something.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Storage --------------------------------------------------------------
# SQLite file. Use ":memory:" for an ephemeral database (tests use this).
DATABASE_PATH=./data/reap.db

# Directory for generated PDFs.
DOCUMENTS_DIR=./documents

# --- Agent identity -------------------------------------------------------
# Stamped onto generated CMAs, brochures, and market reports, and used as the
# signature on drafted replies.
AGENT_NAME="Jordan Reyes"
AGENT_BROKERAGE="Meridian Residential"
AGENT_EMAIL="jordan@meridian.example"
AGENT_PHONE="(555) 010-0142"
AGENT_LICENSE="DRE #01234567"

# --- Inbox provider -------------------------------------------------------
# "simulated" replays a scripted set of inbound emails and needs no
# credentials. "gmail" polls a real inbox and requires the OAuth values below.
INBOX_PROVIDER=simulated
INBOX_POLL_INTERVAL_MS=300000
INBOX_MAX_RESULTS=20

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GMAIL_REFRESH_TOKEN=

# --- Safety layer (optional) --------------------------------------------
# Module specifier for a guard, e.g. "@reap-pro/guard". A guard inspects
# inbound mail before it reaches the queue and outbound copy before it can be
# approved, and can hold either. Unset here: with no guard the platform runs
# exactly as it always has.
GUARD_MODULE=
# Party domains already trusted on live transactions, comma separated. A guard
# uses these to spot a sender impersonating escrow, title, or the brokerage.
KNOWN_DOMAINS=

# --- Intent classifier ----------------------------------------------------
# "rules" is a deterministic keyword classifier with no external calls.
# "anthropic" uses the Claude API and requires ANTHROPIC_API_KEY.
CLASSIFIER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Web client -----------------------------------------------------------
# Consumed by Vite at build time; must be prefixed with VITE_.
VITE_API_URL=http://localhost:3001/api
